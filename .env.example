# Copy this file to a new file named ".env" and fill in real values there.
# The ".env" copy stays on your machine only — Git is told to ignore it.
# In Step 0 there are no secrets yet; this file exists so the habit exists.

# Which environment this copy of the application believes it is in.
# Allowed values: development, test, production
ENVIRONMENT=development

# Where the database lives. The default (in app/config.py) already matches
# docker-compose.yml, so you normally do NOT need to set this on your
# laptop. The live server will set it to the real, secret address.
# DATABASE_URL=postgresql+asyncpg://jobhunter:jobhunter@localhost:5432/jobhunter
