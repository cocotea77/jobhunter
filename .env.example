# Copy this file to a new file named ".env" and fill in real values there.
# The ".env" copy stays on your machine only — Git is told to ignore it.

# Which environment this copy of the application believes it is in.
# Allowed values: development, test, production
ENVIRONMENT=development

# --- Step 2: the AI gateway ---
# Fake mode is ON by default: no key needed, nothing is ever spent.
# To use the real AI service, uncomment BOTH lines and paste your key
# (create one at https://console.anthropic.com — treat it like a password):
#
# FAKE_AI=false
# ANTHROPIC_API_KEY=sk-ant-your-key-here
